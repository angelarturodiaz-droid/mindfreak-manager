# Copiar a .env.local y completar con los valores del proyecto Supabase
# (Dashboard de Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo para crear/gestionar usuarios desde la app (módulo Usuarios y Roles).
# Dashboard de Supabase > Settings > API Keys > pestaña "Publishable and
# secret API keys" > la que dice "secret" (empieza con sb_secret_...).
# NUNCA exponer al cliente ni subir a git — solo se usa en Server Actions.
SUPABASE_SECRET_KEY=

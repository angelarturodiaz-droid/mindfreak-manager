# Copiar a .env.local y completar con los valores del proyecto Supabase
# (Dashboard de Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo para crear/gestionar usuarios desde la app (módulo Usuarios y Roles).
# Dashboard de Supabase > Settings > API Keys > pestaña "Publishable and
# secret API keys" > la que dice "secret" (empieza con sb_secret_...).
# NUNCA exponer al cliente ni subir a git — solo se usa en Server Actions.
SUPABASE_SECRET_KEY=

# Captcha de login (Cloudflare Turnstile) — se muestra solo después de varios
# intentos fallidos seguidos con el mismo correo (comportamiento sospechoso).
# Crear un widget gratis en https://dash.cloudflare.com/?to=/:account/turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY es pública (va al navegador).
# TURNSTILE_SECRET_KEY NUNCA se expone al cliente — solo se usa en el
# Server Action de login para verificar el token contra la API de Cloudflare.
# Si se dejan vacías, el login sigue funcionando normal, simplemente sin
# captcha (no se rompe nada mientras se configura).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMTP para correos que la app manda directo (no vía el mailer de Auth de
# Supabase) — hoy solo el aviso al correo anterior cuando un admin cambia
# el correo de otro usuario (ver lib/mail/send.ts). Puede ser el mismo
# SMTP de Hostinger que ya usas en el dashboard de Supabase, o cambiarlo
# más adelante por un proveedor transaccional dedicado (Resend, SendGrid,
# SES) sin tocar código — son las mismas 4 variables sin importar el
# proveedor.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Opcional — si se omite, usa SMTP_USER como remitente.
SMTP_FROM=
